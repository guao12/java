# ===================== IntelliJ IDEA =====================
.idea/
*.iml
*.iws
*.ipr

# ===================== Java / Maven (springBootTest) =====================
target/
*.class
*.jar
*.war
*.ear

# 本地打包/运行日志
build.log
log/
*.log
*.log.*

# 自带的 Maven 发行包（二进制，体积大，不入库；构建请用系统 Maven 或 mvnw 自动下载）
springBootTest/tools/

# ===================== Node / Vue (DragonRaja-Vue) =====================
node_modules/
dist/
dist-ssr/
.vite/
*.local

# 前端构建产物一律不入库：本地验证时常用 --outDir dist-xxx / dist_xxx 输出到临时目录，
# 这些目录体积大且每次构建都变，曾经被误提交过（dist-b095715 等 204 个文件）。
DragonRaja-Vue/dist-*/
DragonRaja-Vue/dist_*/

# 环境变量文件（按规范不入库；如需示例请保留 .env.example）
.env
.env.*
!.env.example

# 本地私有配置（数据库口令 / JWT 密钥等），覆盖 application.properties 中的同名项，严禁入库
application-local.properties
springBootTest/src/main/resources/application-local.properties

# JWT 密钥文件：启动脚本从这里读出并注入 DR_JWT_SECRET，严禁入库
.run-secret
springBootTest/.run-secret

# ===================== 本机运行残留 =====================
# 启动脚本的重定向输出（log-run.out / log-prod-profile.out / log-test-profile.out）
*.out
# 启动器写下的进程标记（如 .pid8804.txt）
.pid*.txt
# 脚本误创建的 Windows 缓存目录（形如 %SystemDrive%\ProgramData\...）
%SystemDrive%/

# ===================== 浏览器自动化残留 =====================
# Chrome DevTools profile：本地验证登录时生成，约 30MB / 481 个文件，
# 与工程无关且每次运行都在变，2026-11-16 已移出仓库。
DragonRaja-Vue/.cdp-prof/

# ===================== 操作系统 / 编辑器 =====================
.DS_Store
Thumbs.db
*.swp
*~

# ===================== 打包/压缩临时产物 =====================
*.zip
*.tar.gz
